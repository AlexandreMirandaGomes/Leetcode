#!/usr/bin/env sh

set -e

GRADLE_VERSION="8.10.2"
DIST_NAME="gradle-${GRADLE_VERSION}-bin"
DIST_URL="https://services.gradle.org/distributions/${DIST_NAME}.zip"
BASE_DIR="$(cd "$(dirname "$0")"; pwd -P)"
CACHE_DIR="${HOME}/.gradle/wrapper/dists/${DIST_NAME}"
GRADLE_HOME="${CACHE_DIR}/${DIST_NAME}"
ZIP_PATH="${CACHE_DIR}/${DIST_NAME}.zip"

if [ ! -x "${GRADLE_HOME}/bin/gradle" ]; then
  mkdir -p "${CACHE_DIR}"
  if [ ! -f "${ZIP_PATH}" ]; then
    echo "Downloading Gradle ${GRADLE_VERSION}..."
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL "${DIST_URL}" -o "${ZIP_PATH}"
    elif command -v wget >/dev/null 2>&1; then
      wget -q "${DIST_URL}" -O "${ZIP_PATH}"
    else
      echo "Neither curl nor wget is installed."
      exit 1
    fi
  fi

  if command -v unzip >/dev/null 2>&1; then
    unzip -qo "${ZIP_PATH}" -d "${CACHE_DIR}"
  else
    echo "unzip is required to extract Gradle."
    exit 1
  fi
fi

exec "${GRADLE_HOME}/bin/gradle" -p "${BASE_DIR}" "$@"
